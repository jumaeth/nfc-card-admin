# Base URL of the Taplino backend API (NestJS). No trailing slash. Used at build
# time by the /api/v1 proxy in next.config.ts; the browser never calls it directly.
API_URL=http://localhost:3311

# Public base URL of the customer app (links to tap pages /c/[slug] and /p/[slug]).
NEXT_PUBLIC_APP_URL=http://localhost:3310

# Dev only: override the login prefill (ignored outside `next dev`).
# Defaults to the backend's dev user (pnpm db:seed:dev): dev@taplino.ch / taplino-dev.
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=you@taplino.ch
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
